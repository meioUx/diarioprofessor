#!/bin/bash
set -euo pipefail

: "${DATABASE_URL:?Configure DATABASE_URL com a URL interna do PostgreSQL no Render.}"
: "${REDIS_URL:?Configure REDIS_URL com a URL interna do Key Value no Render.}"
: "${SECRET_KEY_BASE:?Configure SECRET_KEY_BASE no Render.}"

if [ "$#" -gt 0 ]; then
  exec "$@"
fi

if [ "${RUN_MIGRATIONS:-1}" = "1" ]; then
  bundle exec rake deployment:prepare
fi

rm -f tmp/pids/server.pid
exec bundle exec puma -b "tcp://0.0.0.0:${PORT:-10000}" -t "${RAILS_MIN_THREADS:-1}:${RAILS_MAX_THREADS:-5}" -e production
